   "source": [
    "## Odd or Even?\n",
    "num = int(input(\"Enter a number:\"))\n",
    "if num == 0:\n",
    "    print(\"The num you entered is neither even or odd\")\n",
    "elif num % 2 == 0:\n",
    "    print(\"The num you have entered is Even\")\n",
    "else:\n",
    "    print(\"The num you have entered is Odd\")\n"
   ]
